{
  "name": "skillflex",
  "version": "0.1.0",
  "private": true,
  "description": "Human, multilingual & switchable soft-skills mentorship platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @skillflex/api",
    "dev:web": "npm run dev -w @skillflex/web",
    "build": "npm run typecheck && npm run build:api && npm run build -w @skillflex/web",
    "build:api": "esbuild apps/api/src/vercel.ts --bundle --platform=node --format=esm --target=node20 --outfile=apps/api/dist/vercel.mjs --external:fastify --external:@fastify/cors --external:@fastify/jwt --external:@fastify/multipart --external:@fastify/static --external:@prisma/client --external:.prisma/client --external:zod --external:bcryptjs --external:dotenv",
    "vercel-build": "npm run db:generate && npm run build:api && npm run build -w @skillflex/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @skillflex/db",
    "db:push": "npm run push -w @skillflex/db",
    "db:seed": "npm run seed -w @skillflex/db",
    "db:studio": "npm run studio -w @skillflex/db",
    "db:reset": "npm run reset -w @skillflex/db",
    "env": "node scripts/ensure-env.mjs",
    "setup": "npm install && npm run env && npm run db:generate && npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
