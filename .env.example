# --- API ---
NODE_ENV=development
PORT=4000

# Postgres (Supabase). Prisma has no dynamic `provider`, so this is Postgres in
# dev too — point it at a Supabase project (a second free one for dev if you
# don't want dev and prod sharing a database).
#
# Use the SESSION-mode pooler (port 5432 on aws-0-<region>.pooler.supabase.com).
# NOT the transaction pooler on 6543: this app uses interactive $transaction()
# in auth, feedback, mentorship and orgs, and those need connection affinity.
# NOT the direct db.<ref>.supabase.co host either — it is IPv6-only on the free
# tier, which Vercel functions cannot reach.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=1"

# Must be a real random value in production — this placeholder is public.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me-in-prod-0000000000"
JWT_EXPIRES_IN=7d

# local | supabase | bunny | cloudflare
#   local    — writes to ./storage, only provider that accepts bytes through the API
#   supabase — signed direct upload to a PRIVATE bucket; required on Vercel
MEDIA_PROVIDER=local

# where the local mock provider stores uploaded files
STORAGE_DIR=../../storage

# --- Supabase Storage (required when MEDIA_PROVIDER=supabase) ---
# The service role key is admin-level and bypasses RLS. Server-side only —
# never give it a VITE_ prefix or Vite will inline it into the public bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=submissions

# --- Retention cron (Vercel Cron sends this as a bearer token) ---
CRON_SECRET=

# --- AI Support chatbot (/ai-support) ---
# Any OpenAI-compatible chat-completions endpoint. Groq is the default because it
# has a free tier — get a key at https://console.groq.com/keys.
# Leave the key blank and the support bot uses a built-in deterministic responder
# instead: the page still works, the answers are just the canned ones.
# Server-side only. Never give these a VITE_ prefix.
SUPPORT_LLM_BASE_URL=https://api.groq.com/openai/v1
SUPPORT_LLM_API_KEY=
# Hosted model IDs get retired periodically — check Groq's model list if replies
# start failing. Any chat model on the endpoint above works.
SUPPORT_LLM_MODEL=llama-3.3-70b-versatile

CORS_ORIGIN=http://localhost:5173

# --- Web ---
# Unused: apps/web/src/lib/api.ts always calls a relative /api, which Vite
# proxies in dev and is same-origin on Vercel. Kept so .env doesn't look truncated.
VITE_API_URL=http://localhost:4000
