# --- API ---
NODE_ENV=development
PORT=4000
# SQLite for local dev — swap to a postgresql:// url for prod (see ADR 0001).
# Prisma resolves relative file: paths against the schema folder, so this lands
# at packages/db/prisma/dev.db. Requires Prisma >= 6.2 (Json on SQLite).
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me-in-prod-0000000000"
JWT_EXPIRES_IN=7d
# local | bunny | cloudflare
MEDIA_PROVIDER=local
# where the local mock provider stores uploaded files
STORAGE_DIR=../../storage
CORS_ORIGIN=http://localhost:5173

# --- Web (Vite needs the VITE_ prefix) ---
VITE_API_URL=http://localhost:4000
